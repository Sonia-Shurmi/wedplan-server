# ---------------------------------------------------------------------------
# WedPlan server — copy this file to .env and fill in real values.
# Never commit .env.
# ---------------------------------------------------------------------------

# Server
PORT=5000
NODE_ENV=development
CLIENT_URL=http://localhost:3000

# MongoDB
MONGODB_URI=
DATABASE_NAME=wedplan

# Optional: client public/images folder used by `npm run seed:images`
# CLIENT_IMAGES_DIR=../wedplan-client/public/images

# Better Auth (JWT issuer / JWKS — the app that runs Better Auth)
BETTER_AUTH_URL=http://localhost:3000
# Optional override. Defaults to ${BETTER_AUTH_URL}/api/auth/jwks
# BETTER_AUTH_JWKS_URL=http://localhost:3000/api/auth/jwks

# Stripe (test mode)
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
PREMIUM_PRICE_CENTS=1900

# ImgBB (server-side image hosting)
IMGBB_API_KEY=
